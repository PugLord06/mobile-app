<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tripbuddy</groupId>
    <artifactId>tripbuddy-app</artifactId>
    <version>1.0</version>
    <packaging>apk</packaging>
    <name>TripBuddy</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <platform.version>11.0</platform.version>
        <android.plugin.version>4.6.0</android.plugin.version>
    </properties>

    <dependencies>
        <!-- Android SDK -->
        <dependency>
            <groupId>com.google.android</groupId>
            <artifactId>android</artifactId>
            <version>11.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- AndroidX Support Libraries -->
        <dependency>
            <groupId>androidx.appcompat</groupId>
            <artifactId>appcompat</artifactId>
            <version>1.6.1</version>
            <type>aar</type>
        </dependency>

        <!-- Material Design Components -->
        <dependency>
            <groupId>com.google.android.material</groupId>
            <artifactId>material</artifactId>
            <version>1.9.0</version>
            <type>aar</type>
        </dependency>

        <!-- RecyclerView -->
        <dependency>
            <groupId>androidx.recyclerview</groupId>
            <artifactId>recyclerview</artifactId>
            <version>1.3.0</version>
            <type>aar</type>
        </dependency>

        <!-- ConstraintLayout -->
        <dependency>
            <groupId>androidx.constraintlayout</groupId>
            <artifactId>constraintlayout</artifactId>
            <version>2.1.4</version>
            <type>aar</type>
        </dependency>

        <!-- CardView -->
        <dependency>
            <groupId>androidx.cardview</groupId>
            <artifactId>cardview</artifactId>
            <version>1.0.0</version>
            <type>aar</type>
        </dependency>

        <!-- Core KTX -->
        <dependency>
            <groupId>androidx.core</groupId>
            <artifactId>core</artifactId>
            <version>1.10.1</version>
            <type>aar</type>
        </dependency>

        <!-- Activity -->
        <dependency>
            <groupId>androidx.activity</groupId>
            <artifactId>activity</artifactId>
            <version>1.7.2</version>
            <type>aar</type>
        </dependency>
    </dependencies>

    <build>
        <finalName>tripbuddy</finalName>
        <sourceDirectory>src/main/java</sourceDirectory>
        
        <plugins>
            <plugin>
                <groupId>com.jayway.maven.plugins.android.generation2</groupId>
                <artifactId>android-maven-plugin</artifactId>
                <version>${android.plugin.version}</version>
                <configuration>
                    <sdk>
                        <!-- IMPORTANT: Replace this path with your local Android SDK path -->
                        <path>/path/to/android-sdk</path>
                        <platform>30</platform>
                    </sdk>
                    <androidManifestFile>${project.basedir}/src/main/AndroidManifest.xml</androidManifestFile>
                    <assetsDirectory>${project.basedir}/src/main/assets</assetsDirectory>
                    <resourceDirectory>${project.basedir}/src/main/res</resourceDirectory>
                    <nativeLibrariesDirectory>${project.basedir}/src/main/jniLibs</nativeLibrariesDirectory>
                    <undeployBeforeDeploy>true</undeployBeforeDeploy>
                </configuration>
                <extensions>true</extensions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>