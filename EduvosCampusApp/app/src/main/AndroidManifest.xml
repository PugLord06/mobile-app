<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EduvosCampusApp"
        tools:targetApi="31">
        
        <!-- Splash Screen Activity -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EduvosCampusApp.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Login Activity -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.EduvosCampusApp.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Registration Activity -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.EduvosCampusApp.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:label="@string/app_name" />
        
        <!-- Course Details Activity -->
        <activity
            android:name=".activities.CourseDetailActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />
        
        <!-- Profile Activity -->
        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />
        
        <!-- Timetable Activity -->
        <activity
            android:name=".activities.TimetableActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />
        
        <!-- Grades Activity -->
        <activity
            android:name=".activities.GradesActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />
        
    </application>

</manifest>